APP_ENV=development
API_PORT=7302

DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@localhost:7311/retouch
REDIS_URL=redis://localhost:7312

S3_ENDPOINT=http://localhost:7313
# 浏览器访问签名 URL 的地址；空则与 S3_ENDPOINT 相同。deploy profile 由 compose 覆盖
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
S3_BUCKET=retouch
S3_URL_TTL=900

# 生产环境必须替换为随机值
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_HOURS=24

# mock 使用本地占位图，不产生任何调用费用；接真实模型时改为 dashscope 或 volcengine
IMAGE_PROVIDER=mock
DASHSCOPE_API_KEY=
# 可改为业务空间专属域名 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
IMAGE_EDIT_MODEL=qwen-image-edit-max
PLANNER_MODEL=qwen-plus

# 火山引擎方舟：IMAGE_PROVIDER=volcengine 用 Seedream 出图，PLANNER_PROVIDER=volcengine 用豆包规划
# 两者可单独切换；模型名也可填控制台的推理接入点 ID（ep-xxx）
# 规划模型：dashscope | volcengine | deepseek
PLANNER_PROVIDER=dashscope
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-0-250828
VOLCENGINE_PLANNER_MODEL=doubao-seed-1-6-250615

# DeepSeek 官方接口：PLANNER_PROVIDER=deepseek 时用于对话规划
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLANNER_MODEL=deepseek-chat
# auto 优先 rembg，corner 仅四角抠图
MATTING_PROVIDER=auto
# auto 有 rapidocr 则拆出文字层，none 跳过
OCR_PROVIDER=auto
